HOST=127.0.0.1
PORT=8080
# Single DB setting for migrations, API and worker. Use the session pooler (5432)
# or direct connection. Port 6543 transaction pooling is not supported.
# The login must own migrations and be able to SET ROLE to the runtime roles.
# Migrations grant those memberships; API/worker pools select restricted roles.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-only secret/service-role key, not the publishable/anonymous browser key.
SUPABASE_SECRET_KEY=
SUPABASE_CV_BUCKET=cv-private
# Generate once: openssl rand -base64 32. Keep stable across restarts.
CV_ENCRYPTION_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Gemini free-tier model; project quotas and billing tier still apply.
LLM_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_CACHE_DIR=.cache/fastembed
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RUST_LOG=info,careerbridge_be::infrastructure::worker=debug,careerbridge_be::infrastructure::llm=debug,careerbridge_be::presentation::events=debug,careerbridge_be::presentation::http=debug

# false is accepted only for loopback development. Set true behind production HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Temporary testing: skip email ownership verification for NEW signups only.
# Set true to require Supabase signup OTP again (default when omitted).
AUTH_SIGNUP_OTP_ENABLED=false

# Vacancy scheduler. openwebninja = Google for Jobs (Indonesia), runs at most daily from
# the job_search_queries queue. Guide: docs/JOB_SEARCH_QUEUE.md
JOB_SCRAPE_ENABLED=false
JOB_SCRAPE_INTERVAL_SECONDS=21600
JOB_SCRAPE_SOURCES=grab,cermati,dkatalis,softwareseni,kredivo,openwebninja
# Each queued keyword is one billed request (Basic plan: 100/month). 2/day ~ 60/month.
OPENWEBNINJA_API_KEY=
OPENWEBNINJA_QUERIES_PER_RUN=2
