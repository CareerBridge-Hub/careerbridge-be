HOST=127.0.0.1
PORT=8080
# Use PostgreSQL role careerbridge_api. Require TLS with sslmode=verify-full in production.
DATABASE_URL=postgresql://careerbridge_api:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
WORKER_DATABASE_URL=postgresql://careerbridge_worker:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Owner connection, used only by cargo run --bin migrate
MIGRATION_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=server-only-supabase-secret-key
SUPABASE_CV_BUCKET=cv-private
# Generate: openssl rand -base64 32. Keep stable across restarts and backups.
CV_ENCRYPTION_KEY=BASE64_32_RANDOM_BYTES
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=server-only-gemini-key
# Explicitly choose a currently supported model in your Gemini project.
LLM_MODEL=SET_SUPPORTED_GEMINI_MODEL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_CACHE_DIR=.cache/fastembed
# Set to the approved 40-character HuggingFace snapshot commit after provisioning.
# EMBEDDING_MODEL_REVISION=
RUST_LOG=info
